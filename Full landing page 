<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Responsive Landing Page</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; line-height:1.6; transition: background-color 0.5s, color 0.5s; scroll-behavior: smooth; }
    body.light { background-color:#f4f4f9; color:#222; }
    body.dark { background-color:#121212; color:#f1f1f1; }

    nav {
      width:100%; padding:1rem 2rem; display:flex; justify-content:space-between; align-items:center;
      position:fixed; top:0; left:0; z-index:1000; background:rgba(0,0,0,0.5); backdrop-filter:blur(10px);
      transition: background 0.5s;
    }
    nav .logo { font-size:1.5rem; font-weight:bold; color:#fff; }
    nav .nav-links { display:flex; gap:1rem; }
    nav .nav-links a {
      color:#fff; text-decoration:none; padding:0.5rem; transition: color 0.3s;
    }
    nav .nav-links a:hover { color:#ff9800; }
    nav button { padding:0.5rem 1rem; border:none; border-radius:20px; cursor:pointer; font-size:1rem; transition: background 0.3s; }
    nav button:hover { opacity:0.8; }

    .hero { height:100vh; display:flex; justify-content:center; align-items:center; text-align:center;
      background: url("./images/hero.jpg"), url("https://source.unsplash.com/1600x900/?technology,abstract") no-repeat center center/cover;
      position:relative; color:white; animation: fadeIn 2s ease-in-out;
    }
    .hero::after { content:""; position:absolute; top:0; left:0; height:100%; width:100%; background:rgba(0,0,0,0.5); }
    .hero-content { position:relative; z-index:2; max-width:800px; padding:20px; animation: slideUp 1.5s ease-out; }
    .hero h1 { font-size:3rem; margin-bottom:1rem; }
    .hero p { font-size:1.2rem; margin-bottom:2rem; }
    .hero a { display:inline-block; padding:0.75rem 1.5rem; background:#ff9800; color:#fff; text-decoration:none; border-radius:30px; transition: background 0.3s; }
    .hero a:hover { background:#e68900; }

    .about { display:flex; flex-wrap:wrap; align-items:center; padding:4rem 2rem; gap:2rem; }
    .about img { flex:1 1 400px; max-width:100%; border-radius:15px; content: url("./images/about.jpg"); }
    .about-text { flex:1 1 400px; }
    .about-text h2 { font-size:2rem; margin-bottom:1rem; }
    .about-text p { font-size:1.1rem; line-height:1.8; }

    .features { padding:4rem 2rem; text-align:center; }
    .features h2 { font-size:2rem; margin-bottom:2rem; }
    .feature-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:2rem; }
    .card { padding:2rem; border-radius:15px; background:rgba(255,255,255,0.9); transition: transform 0.3s, background 0.3s; }
    body.dark .card { background:rgba(30,30,30,0.9); }
    .card:hover { transform:translateY(-10px); }
    .card h3 { margin-bottom:1rem; }

    footer { padding:2rem; text-align:center; background:#222; color:#fff; }
    body.dark footer { background:#111; }
    footer .socials { margin:1rem 0; }
    footer .socials a { margin:0 0.5rem; color:#fff; text-decoration:none; font-size:1.5rem; transition: color 0.3s; }
    footer .socials a:hover { color:#ff9800; }
    footer p { font-size:0.9rem; }

    @keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
    @keyframes slideUp { from{transform:translateY(50px); opacity:0;} to{transform:translateY(0); opacity:1;} }

    @media(max-width:768px){ .hero h1{font-size:2.2rem;} .hero p{font-size:1rem;} nav .nav-links{display:none;} }
    @media(max-width:480px){
      nav .logo{font-size:1.2rem;} nav button{font-size:0.9rem; padding:0.3rem 0.8rem;}
      .hero h1{font-size:1.8rem;} .hero p{font-size:0.9rem;}
    }
  </style>
</head>
<body class="light">
  <!-- Navbar -->
  <nav>
    <div class="logo">MyLanding</div>
    <div class="nav-links">
      <a href="#hero">Home</a>
      <a href="#about">About</a>
      <a href="#features">Features</a>
      <a href="#footer">Contact</a>
    </div>
    <button id="modeToggle">🌙 Dark Mode</button>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1>Welcome to My Landing Page</h1>
      <p>Fully responsive, with dark/light mode and smooth animations.</p>
      <a href="#about">Get Started</a>
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <img id="aboutImage" src="https://ibb.co/rRdZz0MZ" alt="About us">
    <div class="about-text">
      <h2>About Us</h2>
      <p>We create modern, responsive websites that adapt to any device.
         Our mission is to make technology more accessible and user-friendly.
         With smooth animations and beautiful design, we bring ideas to life.</p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features" id="features">
    <h2>Our Features</h2>
    <div class="feature-cards">
      <div class="card"><h3>⚡ Fast</h3><p>Optimized for performance with lightweight code and responsive design.</p></div>
      <div class="card"><h3>🎨 Modern Design</h3><p>Clean layouts with smooth animations and a professional look.</p></div>
      <div class="card"><h3>📱 Responsive</h3><p>Looks amazing on desktop, tablet, and mobile devices alike.</p></div>
    </div>
  </section>

  <!-- Footer Section -->
  <footer id="footer">
    <div class="socials">
      <a href="#" target="_blank">🌐</a>
      <a href="#" target="_blank">🐦</a>
      <a href="#" target="_blank">📸</a>
      <a href="#" target="_blank">💼</a>
    </div>
    <p>&copy; 2025 MyLanding. All rights reserved.</p>
  </footer>

  <script>
    // Dark/Light mode toggle
    const toggleBtn = document.getElementById("modeToggle");
    const body = document.body;
    toggleBtn.addEventListener("click", () => {
      body.classList.toggle("dark");
      body.classList.toggle("light");
      toggleBtn.textContent = body.classList.contains("dark") ? "☀️ Light Mode" : "🌙 Dark Mode";
    });

    // About image fallback for TREBEDIT
    const aboutImg = document.getElementById("aboutImage");
    aboutImg.onerror = function() {
      this.src = "https://source.unsplash.com/600x400/?business,team";
    }
  </script>
</body>
</html>